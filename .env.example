# Telegram API credentials
# Create your own credentials at my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Comma-separated Telegram chat IDs to collect.
# Negative IDs are normal.
# Example:
# TELEGRAM_ALLOWED_CHAT_IDS=-100123456789,-100987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Application
LOG_LEVEL=INFO

# Reserved for later API functionality
API_HOST=127.0.0.1
API_PORT=8765
